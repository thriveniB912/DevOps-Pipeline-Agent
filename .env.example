# Postgres (docker-compose up -d db). Leave unset to use a local SQLite file.
DATABASE_URL=postgresql+psycopg2://ops:ops@localhost:5432/opsmemory

# LLM (optional - without a key the agent uses a built-in rule-based responder)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Hindsight (optional - docker-compose --profile hindsight up -d)
HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_BANK=opsmemory
